{
  "name": "@clockgrove/factory",
  "version": "1.0.2",
  "description": "Derived-state engineering management for GitHub.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/factory.js && esbuild src/mcp-server.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/mcp-server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/core": "^6.1.4",
    "@octokit/plugin-paginate-rest": "^11.4.0",
    "@octokit/plugin-retry": "^7.1.2",
    "@octokit/plugin-throttling": "^9.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
