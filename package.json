{
  "name": "@clockgrove/factory",
  "version": "0.1.64",
  "description": "Objective-driven development plugin for a target repository",
  "homepage": "https://github.com/clockgrove/factory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockgrove/factory.git"
  },
  "bugs": {
    "url": "https://github.com/clockgrove/factory/issues"
  },
  "keywords": [
    "codex",
    "development",
    "github",
    "plugin",
    "objectives"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "factory": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "docs/AGENT-HARNESSES.md",
    ".codex-plugin",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/OPENAI-MANAGED.md",
    "docs/CLAUDE-MANAGED.md",
    "docs/SANDBOX-EXECUTION.md",
    "docs/CAPTURE-EXPORT.md",
    "docs/LOCAL-ANALYSIS.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "release": "node scripts/release.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint . && eslint src",
    "format:check": "biome format . && prettier --check package-lock.json \"**/*.{md,yml,yaml}\"",
    "format": "biome format --write . && prettier --write package-lock.json \"**/*.{md,yml,yaml}\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "package": "npm pack --dry-run",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check",
    "test:pr": "npm run build && node scripts/test-pr.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.5.2",
    "eslint": "9.39.5",
    "pnpm": "10.34.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.44.1",
    "@daytonaio/sdk": "0.220.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@octokit/core": "^7.0.8",
    "@openai/codex-sdk": "0.156.0",
    "@secretlint/node": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "tar": "7.5.22",
    "yaml": "2.9.0"
  },
  "bundleDependencies": [
    "@octokit/core",
    "@openai/codex-sdk",
    "@secretlint/node",
    "@secretlint/secretlint-rule-preset-recommend",
    "yaml",
    "tar",
    "@anthropic-ai/sdk"
  ],
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@github/copilot-sdk": "1.0.13",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@daytonaio/sdk": "0.220.0"
  },
  "peerDependenciesMeta": {
    "@daytonaio/sdk": {
      "optional": true
    }
  }
}
