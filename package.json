{
  "name": "@clockgrove/factory",
  "version": "0.1.25",
  "description": "Objective-driven development plugin for a target repository",
  "homepage": "https://github.com/clockgrove/factory-rebuild#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockgrove/factory-rebuild.git"
  },
  "bugs": {
    "url": "https://github.com/clockgrove/factory-rebuild/issues"
  },
  "keywords": [
    "codex",
    "development",
    "github",
    "plugin",
    "objectives"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "factory": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    ".codex-plugin",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint . && eslint src",
    "format:check": "biome format . && prettier --check package-lock.json \"**/*.{md,yml,yaml}\"",
    "format": "biome format --write . && prettier --write package-lock.json \"**/*.{md,yml,yaml}\"",
    "test": "npm run build && node --test test/*.test.mjs",
    "package": "npm pack --dry-run",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.5.2",
    "eslint": "9.39.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.44.1"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.156.0",
    "@secretlint/node": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5"
  },
  "bundleDependencies": [
    "@openai/codex-sdk",
    "@secretlint/node",
    "@secretlint/secretlint-rule-preset-recommend"
  ]
}
