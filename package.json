{
  "name": "@clockgrove/factory",
  "version": "0.3.85",
  "description": "Objective-driven development plugin for a target repository",
  "homepage": "https://github.com/clockgrove/factory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockgrove/factory.git"
  },
  "bugs": {
    "url": "https://github.com/clockgrove/factory/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "development",
    "github",
    "plugin",
    "objectives"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "factory": "./core/dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./core/dist/index.d.ts",
      "default": "./core/dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "core/dist",
    "skills",
    "assets",
    "docs/USER-GUIDE.md",
    "docs/CORE.md",
    "docs/templates",
    ".codex-plugin",
    ".claude-plugin/plugin.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "biome lint --error-on-warnings .",
    "format:check": "biome format . && prettier --check \"**/*.{md,yml,yaml}\"",
    "format": "biome format --write . && prettier --write \"**/*.{md,yml,yaml}\"",
    "test": "npm run build && node --import ./test/isolate-env.mjs --test --test-timeout=300000 test/*.test.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check",
    "build:core": "tsc -p core/tsconfig.json",
    "prepack": "npm run build:core",
    "test:core": "npm run build:core && node --test --test-timeout=120000 core/test/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.5.2",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@octokit/core": "^7.0.8",
    "@openai/codex-sdk": "0.160.0",
    "@secretlint/node": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "hast-util-from-html": "2.0.3",
    "hast-util-to-mdast": "10.1.2",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.2.0",
    "tar": "7.5.22",
    "yaml": "2.9.0"
  },
  "bundleDependencies": [
    "@octokit/core",
    "@openai/codex-sdk",
    "@secretlint/node",
    "@secretlint/secretlint-rule-preset-recommend",
    "yaml",
    "tar",
    "@anthropic-ai/sdk",
    "hast-util-from-html",
    "hast-util-to-mdast",
    "mdast-util-gfm",
    "mdast-util-to-markdown"
  ],
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@github/copilot-sdk": "1.0.13",
    "zod": "4.6.5"
  }
}
