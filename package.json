{
  "name": "@clockgrove/factory",
  "version": "0.1.75",
  "description": "Objective-driven development plugin for a target repository",
  "homepage": "https://github.com/clockgrove/factory#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clockgrove/factory.git"
  },
  "bugs": {
    "url": "https://github.com/clockgrove/factory/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "development",
    "github",
    "plugin",
    "objectives"
  ],
  "type": "module",
  "license": "MIT",
  "bin": {
    "factory": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "assets",
    "docs/AGENT-HARNESSES.md",
    "docs/USER-GUIDE.md",
    ".codex-plugin",
    ".claude-plugin/plugin.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/REMOTE-EXECUTION.md",
    "docs/CAPTURE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "biome lint --error-on-warnings . && node scripts/check-ts-directives.mjs",
    "format:check": "biome format . && prettier --check package-lock.json \"**/*.{md,yml,yaml}\"",
    "format": "biome format --write . && prettier --write package-lock.json \"**/*.{md,yml,yaml}\"",
    "test": "npm run build && node --import ./test/isolate-env.mjs --test --test-timeout=300000 test/*.test.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "notices:check": "node scripts/generate-notices.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^24.5.2",
    "ajv": "^8.20.0",
    "pnpm": "10.34.5",
    "prettier": "^3.6.2",
    "semver": "^7.8.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@octokit/core": "^7.0.8",
    "@openai/codex-sdk": "0.160.0",
    "@secretlint/node": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "tar": "7.5.22",
    "yaml": "2.9.0"
  },
  "bundleDependencies": [
    "@octokit/core",
    "@openai/codex-sdk",
    "@secretlint/node",
    "@secretlint/secretlint-rule-preset-recommend",
    "yaml",
    "tar",
    "@anthropic-ai/sdk"
  ],
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.281",
    "@github/copilot-sdk": "1.0.13",
    "zod": "4.6.5"
  }
}
