{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/artifact.schema.json",
  "title": "Factory Normalized Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol", "baseSha", "digest", "patch", "changedPaths", "commands", "logs", "outcome", "createdAt"],
  "properties": {
    "protocol": { "const": "clockgrove.factory/artifact-v1" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "patch": { "type": "string", "maxLength": 5242880 },
    "changedPaths": { "type": "array", "maxItems": 10000, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "commands": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": true, "required": ["command", "exitCode", "durationMs"], "properties": { "command": { "type": "string", "maxLength": 1000 }, "exitCode": { "type": "integer" }, "durationMs": { "type": "integer", "minimum": 0 } } } },
    "logs": { "type": "string", "maxLength": 65536 },
    "outcome": { "enum": ["succeeded", "failed", "declined"] },
    "reason": { "type": "string", "maxLength": 8000 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
