{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/artifact.schema.json",
  "title": "Factory Normalized Artifact",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "phase", "failureClass", "supportedBehavior", "observedBehavior", "reproduction", "impact", "evidence"],
      "properties": {
        "protocol": { "const": "clockgrove.factory/finding-v1" },
        "phase": { "enum": ["worker", "validation", "review", "integration", "compiler", "supervisor"] },
        "failureClass": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,159}$" },
        "supportedBehavior": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "observedBehavior": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "reproduction": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "impact": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "possibleCause": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "digest"],
            "properties": {
              "kind": { "enum": ["worker-packet", "artifact", "validation", "review", "integration-candidate", "compiler-result", "supervisor-observation"] },
              "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
            }
          }
        },
        "commonCauseEvidence": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
      }
    }
  },
  "required": [
    "protocol",
    "baseSha",
    "digest",
    "patch",
    "changedPaths",
    "commands",
    "logs",
    "outcome",
    "createdAt"
  ],
  "properties": {
    "protocol": { "const": "clockgrove.factory/artifact" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "patch": { "type": "string", "maxLength": 5242880 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest", "bytes", "chunks"],
      "properties": {
        "kind": { "const": "content-chunks" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["digest", "bytes"],
            "properties": {
              "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
            }
          }
        }
      }
    },
    "fileManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseTreeSha", "resultTreeSha", "files"],
      "properties": {
        "baseTreeSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "resultTreeSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "files": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "mode", "bytes", "digest", "mediaType", "generated"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "action": { "enum": ["write", "delete"] },
              "mode": { "enum": ["100644", "100755", "120000"] },
              "bytes": { "type": "integer", "minimum": 0, "maximum": 100000000 },
              "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "mediaType": {
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/gif",
                  "image/webp",
                  "application/pdf",
                  "application/wasm",
                  "application/zip",
                  "audio/wav",
                  "video/mp4",
                  "unknown"
                ]
              },
              "generated": { "type": "boolean" }
            },
            "if": { "properties": { "mode": { "const": "120000" } } },
            "then": { "properties": { "mediaType": { "const": "unknown" } } }
          }
        }
      }
    },
    "changedPaths": {
      "type": "array",
      "maxItems": 10000,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "commands": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["command", "exitCode", "durationMs"],
        "properties": {
          "command": { "type": "string", "maxLength": 1000 },
          "exitCode": { "type": "integer" },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "logs": { "type": "string", "maxLength": 65536 },
    "outcome": { "enum": ["succeeded", "failed", "declined"] },
    "reason": { "type": "string", "maxLength": 8000 },
    "findings": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/definitions/finding" }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
