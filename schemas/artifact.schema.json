{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/artifact.schema.json",
  "title": "Factory Normalized Artifact",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol",
    "baseSha",
    "digest",
    "patch",
    "changedPaths",
    "commands",
    "logs",
    "outcome",
    "createdAt"
  ],
  "properties": {
    "protocol": { "const": "clockgrove.factory/artifact-v1" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "patch": { "type": "string", "maxLength": 5242880 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest", "bytes", "chunks"],
      "properties": {
        "kind": { "const": "git-patch-chunks-v1" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["digest", "bytes"],
            "properties": {
              "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 1, "maximum": 4194304 }
            }
          }
        }
      }
    },
    "fileManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "baseTreeSha", "resultTreeSha", "files"],
      "properties": {
        "version": { "const": 1 },
        "baseTreeSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "resultTreeSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "files": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "action", "mode", "bytes", "digest", "mediaType", "generated"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 500 },
              "action": { "enum": ["write", "delete"] },
              "mode": { "enum": ["100644", "100755"] },
              "bytes": { "type": "integer", "minimum": 0, "maximum": 100000000 },
              "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "mediaType": {
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "image/gif",
                  "image/webp",
                  "application/pdf",
                  "application/wasm",
                  "application/zip",
                  "audio/wav",
                  "video/mp4",
                  "unknown"
                ]
              },
              "generated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "changedPaths": {
      "type": "array",
      "maxItems": 10000,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "commands": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["command", "exitCode", "durationMs"],
        "properties": {
          "command": { "type": "string", "maxLength": 1000 },
          "exitCode": { "type": "integer" },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "logs": { "type": "string", "maxLength": 65536 },
    "outcome": { "enum": ["succeeded", "failed", "declined"] },
    "reason": { "type": "string", "maxLength": 8000 },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
