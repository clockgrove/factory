{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/controller-policy.schema.json",
  "title": "Factory v2 Repository Controller Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["scope", "maxActiveObjectives", "maxLocalWorkers", "maxPaidWorkers", "pollIntervalSeconds"],
  "properties": {
    "scope": { "const": "repository" },
    "maxActiveObjectives": { "const": 1 },
    "maxLocalWorkers": { "type": "integer", "minimum": 1, "maximum": 32 },
    "maxPaidWorkers": { "type": "integer", "minimum": 0, "maximum": 32 },
    "pollIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 300 }
  }
}
