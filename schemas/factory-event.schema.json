{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/factory-event.schema.json",
  "title": "Factory v2 Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol", "kind", "event", "objective", "runId", "sequence", "at"],
  "properties": {
    "protocol": { "const": "clockgrove.factory/v2" },
    "kind": { "enum": ["run", "lease", "attempt", "validation", "graph", "budget"] },
    "event": { "type": "string" },
    "objective": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "at": { "type": "string", "format": "date-time" },
    "workItem": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "backend": { "type": "string" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "outputTreeSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "graphDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "graphSize": { "type": "integer", "minimum": 1, "maximum": 100 },
    "graphRef": { "type": "string", "minLength": 1, "maxLength": 500 },
    "graphBlobSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "requestedBy": { "type": "string", "minLength": 1, "maxLength": 160 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" },
    "policyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "passed": { "type": "boolean" },
    "phase": { "enum": ["management", "execution", "validation"] },
    "unit": { "enum": ["model_tokens", "local_milliseconds", "sandbox_milliseconds", "managed_sessions", "validation_milliseconds"] },
    "amount": { "type": "number", "minimum": 0 }
  }
}
