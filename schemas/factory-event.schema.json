{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/factory-event.schema.json",
  "title": "Factory v2 Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol", "kind", "event", "objective", "runId", "sequence", "at"],
  "properties": {
    "protocol": { "const": "clockgrove.factory/v2" },
    "kind": { "enum": ["run", "controller", "lease", "attempt", "scheduling", "capacity", "validation", "graph", "budget"] },
    "event": { "type": "string" },
    "objective": { "type": "integer", "minimum": 1 },
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" },
    "sequence": { "type": "integer", "minimum": 0 },
    "at": { "type": "string", "format": "date-time" },
    "workItem": { "type": "integer", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "backend": { "type": "string" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "outputTreeSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "graphDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "graphSize": { "type": "integer", "minimum": 1, "maximum": 100 },
    "graphRef": { "type": "string", "minLength": 1, "maxLength": 500 },
    "graphBlobSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "controllerId": { "type": "string" },
    "controllerPolicyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "controllerProtocolMin": { "type": "string" },
    "controllerProtocolMax": { "type": "string" },
    "protocolMin": { "type": "string" },
    "protocolMax": { "type": "string" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "requestedBy": { "type": "string", "minLength": 1, "maxLength": 160 },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" },
    "policyDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "passed": { "type": "boolean" },
    "phase": { "enum": ["management", "execution", "validation"] },
    "sessionId": { "type": "string", "minLength": 1, "maxLength": 500 },
    "modelProfile": { "type": "string", "minLength": 1, "maxLength": 160 },
    "reportedModelTokens": { "type": "integer", "minimum": 0 },
    "admissionClass": { "enum": ["local", "remote-required", "burst"] },
    "admissionReason": { "enum": ["local-capacity", "capability-required", "local-saturated", "queue-delay", "deadline"] },
    "requestedCpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
    "requestedMemoryMb": { "type": "integer", "minimum": 1, "maximum": 1048576 },
    "priorityRank": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "priorityFieldId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "priorityOptionId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "subIssuePosition": { "type": "integer", "minimum": 0 },
    "criticalPathLength": { "type": "integer", "minimum": 0 },
    "unfinishedDownstream": { "type": "integer", "minimum": 0 },
    "capacityMeasuredAt": { "type": "string", "format": "date-time" },
    "effectiveCpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
    "availableMemoryMb": { "type": "integer", "minimum": 0, "maximum": 1048576 },
    "loadRatio": { "type": "number", "minimum": 0 },
    "memoryUsageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "directorEpoch": { "type": "integer", "minimum": 1 },
    "observedPriorityRank": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "observedSubIssuePosition": { "type": "integer", "minimum": 0 },
    "unit": { "enum": ["model_tokens", "local_milliseconds", "sandbox_milliseconds", "managed_sessions", "validation_milliseconds"] },
    "amount": { "type": "number", "minimum": 0 }
  }
}
