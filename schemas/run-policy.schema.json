{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/run-policy.schema.json",
  "title": "Factory v2 Run Policy",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "backendOrder",
    "maxParallel",
    "workItemTimeoutMinutes",
    "objectiveTimeoutMinutes",
    "maxAttemptsPerItem",
    "allowedPaidBackends",
    "cloudFallback",
    "maxSandboxMinutes",
    "maxManagedAgentSessions",
    "trust",
    "managementBackend",
    "allowedNetworkDestinations"
  ],
  "properties": {
    "backendOrder": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" }
    },
    "maxParallel": { "type": "integer", "minimum": 1, "maximum": 32 },
    "workItemTimeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "objectiveTimeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 43200 },
    "maxAttemptsPerItem": { "type": "integer", "minimum": 1, "maximum": 10 },
    "allowedPaidBackends": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" }
    },
    "cloudFallback": { "enum": ["never", "explicit"] },
    "maxSandboxMinutes": { "type": "integer", "minimum": 0, "maximum": 100000 },
    "maxManagedAgentSessions": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "trust": { "enum": ["explicitly_activated_repo", "sandbox_untrusted"] },
    "managementBackend": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$"
    },
    "modelProfile": { "type": "string", "minLength": 1, "maxLength": 160 },
    "allowedNetworkDestinations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^(?:\\*\\.)?(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
      }
    },
    "priority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "unsetRank", "onUnavailable"],
      "properties": {
        "source": { "enum": ["subissue-order", "issue-field-then-subissue-order"] },
        "issueFieldId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "optionRanks": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 1000 }
        },
        "unsetRank": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "onUnavailable": { "enum": ["fallback-to-subissue-order", "escalate"] }
      }
    },
    "capacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["fixed", "adaptive-local"] },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxWorkers",
            "defaultCpu",
            "defaultMemoryMb",
            "reserveCpu",
            "reserveMemoryMb",
            "minimumFreeMemoryMb",
            "maxLoadRatio",
            "maxMemoryUsageRatio",
            "sampleIntervalSeconds",
            "admissionCooldownSeconds"
          ],
          "properties": {
            "maxWorkers": { "type": "integer", "minimum": 1, "maximum": 32 },
            "defaultCpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
            "defaultMemoryMb": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "reserveCpu": { "type": "number", "minimum": 0, "maximum": 256 },
            "reserveMemoryMb": { "type": "integer", "minimum": 0, "maximum": 1048576 },
            "minimumFreeMemoryMb": { "type": "integer", "minimum": 0, "maximum": 1048576 },
            "maxLoadRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "maxMemoryUsageRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "sampleIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
            "admissionCooldownSeconds": { "type": "integer", "minimum": 0, "maximum": 300 }
          }
        },
        "backendMaxParallel": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 32 }
        }
      }
    },
    "burst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "backendOrder",
        "maxCloudParallel",
        "queueDelaySeconds",
        "deadlineReserveMinutes",
        "maxPriorityRank"
      ],
      "properties": {
        "mode": { "enum": ["never", "saturation", "queue-delay", "deadline", "queue-or-deadline"] },
        "backendOrder": { "type": "array", "maxItems": 16, "items": { "type": "string" } },
        "maxCloudParallel": { "type": "integer", "minimum": 1, "maximum": 32 },
        "queueDelaySeconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "deadlineReserveMinutes": { "type": "integer", "minimum": 0, "maximum": 43200 },
        "maxPriorityRank": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "onUnavailable", "merge"],
      "properties": {
        "mode": { "enum": ["regular-prs", "stacked-prs"] },
        "onUnavailable": { "enum": ["regular-prs", "escalate"] },
        "merge": { "enum": ["bottom-up", "atomic-stack"] }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "profiles", "phaseProfiles"],
      "properties": {
        "mode": { "const": "single-profile" },
        "profiles": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model", "reasoning"],
            "properties": {
              "model": { "type": "string", "minLength": 1, "maxLength": 160 },
              "reasoning": { "enum": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"] }
            }
          }
        },
        "phaseProfiles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["compile", "implement", "review", "recover"],
          "properties": {
            "compile": { "type": "string" },
            "implement": { "type": "string" },
            "review": { "type": "string" },
            "recover": { "type": "string" }
          }
        }
      }
    },
    "economics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxModelTokens",
        "maxSandboxMinutes",
        "maxManagedSessions",
        "minCloudTimeSavedMinutes"
      ],
      "properties": {
        "maxModelTokens": { "type": "integer", "minimum": 0 },
        "maxSandboxMinutes": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "maxManagedSessions": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "minCloudTimeSavedMinutes": { "type": "integer", "minimum": 0, "maximum": 43200 }
      }
    }
  }
}
