{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/validation-captures.schema.json",
  "title": "Repository validation capture catalog",
  "description": "Optional committed authority for repository-observed capture commands and Factory-installed threshold comparator policies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["captures", "thresholdComparisons"],
  "properties": {
    "captures": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "outputs", "comparisonOutputRoleId", "profile", "gates"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["roleId", "mediaType"],
              "properties": {
                "roleId": { "$ref": "#/definitions/id" },
                "mediaType": { "$ref": "#/definitions/mediaType" }
              }
            }
          },
          "comparisonOutputRoleId": { "$ref": "#/definitions/id" },
          "profile": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "viewport", "output", "captureRoleId", "diffRoleId", "previewRoleId"],
                "properties": {
                  "kind": { "const": "raster" },
                  "viewport": { "$ref": "#/definitions/dimensions" },
                  "output": { "$ref": "#/definitions/dimensions" },
                  "captureRoleId": { "$ref": "#/definitions/id" },
                  "diffRoleId": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
                  "previewRoleId": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] }
                }
              }
            ]
          },
          "gates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": { "enum": ["human-required", "deterministic-preauthorized"] }
          }
        }
      }
    },
    "thresholdComparisons": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["policy"],
        "properties": {
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "metric", "maximumDifference"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "metric": { "$ref": "#/definitions/id" },
              "maximumDifference": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/+\\-]+$"
    },
    "mediaType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+\\-]{0,126}/[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+\\-]{0,126}$"
    },
    "dimensions": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
          }
        }
      ]
    }
  }
}
