{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/validation-evidence.schema.json",
  "title": "Factory Validation Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol", "artifactDigest", "baseSha", "outputTreeSha", "commands", "passed", "startedAt", "completedAt", "digest"],
  "properties": {
    "protocol": { "const": "clockgrove.factory/validation-v1" },
    "artifactDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "outputTreeSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "commands": { "type": "array", "maxItems": 128, "items": { "type": "object", "required": ["command", "exitCode", "durationMs"], "properties": { "command": { "type": "string", "maxLength": 1000 }, "exitCode": { "type": "integer" }, "durationMs": { "type": "integer", "minimum": 0 } } } },
    "passed": { "type": "boolean" },
    "failureReason": { "type": "string", "maxLength": 8000 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
