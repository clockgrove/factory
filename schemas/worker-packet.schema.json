{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/worker-packet.schema.json",
  "title": "Factory Worker Packet",
  "type": "object",
  "additionalProperties": true,
  "required": ["goal", "acceptanceCriteria", "allowedPaths", "preconditions", "outOfScope", "conventions", "baseSha", "validationCommands", "requirements", "artifactContract"],
  "properties": {
    "goal": { "type": "string", "description": "Repository-artifact outcome assigned to the worker; never a Factory-owned lifecycle or scheduling outcome.", "minLength": 1, "maxLength": 4000 },
    "acceptanceCriteria": { "type": "array", "description": "Criteria provable from the candidate artifact and pre-publication validation evidence; never publication, integration, issue closure, accounting, or scheduling outcomes.", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "allowedPaths": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[*?\\[]).+$" } },
    "preconditions": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "outOfScope": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "conventions": { "type": "array", "description": "Repository implementation constraints observable in the candidate artifact; never Factory lifecycle or graph-order instructions.", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "retryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "outcome", "reason"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["failed", "timed_out"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "validationCommands": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "requirements": {
      "type": "object",
      "additionalProperties": true,
      "required": ["os", "architecture", "tools", "services", "networkDestinations", "permittedSecretNames", "trust"],
      "properties": {
        "os": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "architecture": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "cpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
        "memoryMb": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "diskMb": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "estimatedDurationMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "tools": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" } },
        "services": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" } },
        "networkDestinations": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 253 } },
        "permittedSecretNames": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" } },
        "trust": { "enum": ["trusted_local", "isolated", "managed"] },
        "evidence": {
          "type": "array", "maxItems": 16,
          "description": "Trusted provenance for compiler-grounded platform, resource, artifact, and timeout requirements.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["field", "kind", "source"],
            "properties": {
              "field": { "enum": ["os", "architecture", "cpu", "memoryMb", "diskMb", "timeoutMinutes", "artifactContract"] },
              "kind": { "enum": ["repository", "run-policy", "factory-default"] },
              "source": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mustRead", "searchSeeds", "dependencyEvidence"],
      "properties": {
        "mustRead": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "searchSeeds": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "dependencyEvidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workItem", "commit"],
            "properties": {
              "workItem": { "type": "string" },
              "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
            }
          }
        }
      }
    },
    "changeSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mergeClass", "exclusiveResources"],
      "properties": {
        "mergeClass": { "enum": ["parallel-safe", "exclusive", "generated", "large-binary"] },
        "exclusiveResources": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "relationship"],
      "properties": {
        "group": { "type": "string" },
        "relationship": { "enum": ["root", "continue-stack", "sibling", "join-after-merge"] },
        "parentWorkItem": { "type": "string" }
      }
    },
    "artifactContract": { "const": "clockgrove.factory/artifact-v1" }
  }
}
