{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/worker-packet.schema.json",
  "title": "Factory Worker Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "goal",
    "acceptanceCriteria",
    "allowedPaths",
    "preconditions",
    "outOfScope",
    "conventions",
    "baseSha",
    "validationCommands",
    "requirements",
    "deliverable"
  ],
  "properties": {
    "protocol": { "const": "clockgrove.factory/worker-packet" },
    "goal": {
      "type": "string",
      "description": "Repository-artifact outcome assigned to the worker; never a Factory-owned lifecycle or scheduling outcome.",
      "minLength": 1,
      "maxLength": 4000
    },
    "acceptanceCriteria": {
      "type": "array",
      "description": "Criteria provable from the candidate artifact and pre-publication validation evidence; never publication, integration, issue closure, accounting, or scheduling outcomes.",
      "minItems": 1,
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "allowedPaths": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[*?\\[]).+$"
      }
    },
    "preconditions": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "outOfScope": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "conventions": {
      "type": "array",
      "description": "Repository implementation constraints observable in the candidate artifact; never Factory lifecycle or graph-order instructions.",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "retryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "outcome", "reason"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["failed", "timed_out"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "validationCommands": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "os",
        "architecture",
        "tools",
        "services",
        "networkDestinations",
        "permittedSecretNames",
        "trust"
      ],
      "properties": {
        "os": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "architecture": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 40 }
        },
        "cpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
        "memoryMb": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "diskMb": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "estimatedDurationMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "tools": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" }
        },
        "services": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" }
        },
        "networkDestinations": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "permittedSecretNames": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" }
        },
        "trust": { "enum": ["trusted_local", "isolated", "managed"] },
        "evidence": {
          "type": "array",
          "maxItems": 16,
          "description": "Trusted provenance for compiler-grounded platform, resource, artifact, and timeout requirements.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "kind", "source"],
            "properties": {
              "field": {
                "enum": [
                  "os",
                  "architecture",
                  "cpu",
                  "memoryMb",
                  "diskMb",
                  "timeoutMinutes",
                  "deliverable"
                ]
              },
              "kind": { "enum": ["repository", "run-policy", "factory-default"] },
              "source": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mustRead", "searchSeeds", "dependencyEvidence"],
      "properties": {
        "mustRead": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "searchSeeds": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "dependencyEvidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workItem", "commit"],
            "properties": {
              "workItem": { "type": "string" },
              "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
            }
          }
        }
      }
    },
    "changeSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mergeClass", "exclusiveResources"],
      "properties": {
        "mergeClass": { "enum": ["parallel-safe", "exclusive", "generated", "large-binary"] },
        "exclusiveResources": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "relationship"],
      "properties": {
        "group": { "type": "string" },
        "relationship": { "enum": ["root", "continue-stack", "sibling", "join-after-merge"] },
        "parentWorkItem": { "type": "string" }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tier", "criteria"],
        "properties": {
          "tier": { "enum": ["mechanical", "semantic", "deterministic-simulation"] },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
          },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidenceCommands": {
            "type": "array",
            "maxItems": 32,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        }
      }
    },
    "criterionRisks": {
      "type": "array",
      "description": "Explicit criterion risk classifications emitted by the compiler. Legacy packets may omit this field.",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "risk"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "risk": {
            "enum": [
              "ordinary",
              "safety",
              "security",
              "destructive-action",
              "accounting",
              "recovery"
            ]
          }
        }
      }
    },
    "repositoryCapabilities": {
      "type": "object",
      "description": "Host-derived deferred repository capability bindings. These establish immutable plan provenance, not executable authority; the Supervisor must resolve integrated-base requirements again before dispatch.",
      "additionalProperties": false,
      "required": ["provides", "requires"],
      "properties": {
        "provides": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "generation", "authorityPaths", "operations"],
            "properties": {
              "adapter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/+\\-]+$"
              },
              "generation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/+\\-]+$"
              },
              "authorityPaths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[*?\\[]).+$"
                }
              },
              "operations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": { "$ref": "#/definitions/repositoryCapabilityOperation" }
              },
              "runtime": { "$ref": "#/definitions/runtimeBundleRequirement" }
            }
          }
        },
        "requires": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adapter",
              "generation",
              "providerWorkItem",
              "authorityPaths",
              "operation",
              "activation"
            ],
            "properties": {
              "adapter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/+\\-]+$"
              },
              "generation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/+\\-]+$"
              },
              "providerWorkItem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:/+\\-]+$"
              },
              "authorityPaths": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500,
                  "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[*?\\[]).+$"
                }
              },
              "operation": { "$ref": "#/definitions/repositoryCapabilityOperation" },
              "activation": { "enum": ["artifact", "integrated-base"] },
              "runtime": { "$ref": "#/definitions/runtimeBundleRequirement" }
            }
          }
        }
      }
    },
    "managedRuntimes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/definitions/runtimeBundleRequirement" }
    },
    "assetInputs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifestDigest",
          "descriptorDigest",
          "contentDigest",
          "storageReceiptDigest",
          "path"
        ],
        "properties": {
          "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "descriptorDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "storageReceiptDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "path": {
            "type": "string",
            "pattern": "^assets/[a-f0-9]{64}/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "purpose": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "deliverable": { "$ref": "#/definitions/workItemDeliverable" },
    "generatedAssetRequirements": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/generatedAssetRequirement" }
    },
    "mediaUses": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/definitions/workerMediaIntentUse" }
    },
    "repositoryCaptureRecipes": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/definitions/repositoryCaptureRecipe" }
    }
  },
  "definitions": {
    "mediaIntentRole": { "$ref": "#/definitions/safeId" },
    "mediaIntentPurpose": {
      "enum": ["decision-input", "implementation-reference", "product-asset", "acceptance-evidence"]
    },
    "mediaIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "purpose",
        "necessity",
        "obligationIds",
        "rationale",
        "brief",
        "fulfillment",
        "output",
        "review",
        "repositoryCapture",
        "bindings"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/safeId" },
        "role": { "$ref": "#/definitions/mediaIntentRole" },
        "purpose": { "$ref": "#/definitions/mediaIntentPurpose" },
        "necessity": { "enum": ["required", "helpful"] },
        "obligationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "brief": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "fulfillment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "assetIds"],
              "properties": {
                "kind": { "const": "imported" },
                "assetIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": { "$ref": "#/definitions/safeId" }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "inputRoleBindings"],
              "properties": {
                "kind": { "const": "produced" },
                "inputRoleBindings": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["roleId", "importedAssetIds", "inputIntentIds"],
                    "properties": {
                      "roleId": { "$ref": "#/definitions/safeId" },
                      "importedAssetIds": {
                        "type": "array",
                        "maxItems": 32,
                        "uniqueItems": true,
                        "items": { "$ref": "#/definitions/safeId" }
                      },
                      "inputIntentIds": {
                        "type": "array",
                        "maxItems": 32,
                        "uniqueItems": true,
                        "items": { "$ref": "#/definitions/safeId" }
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mediaTypes", "minimumCount", "maximumCount", "profile"],
          "properties": {
            "mediaTypes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+\\-]{0,126}/[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+\\-]{0,126}$"
              }
            },
            "minimumCount": { "type": "integer", "minimum": 1, "maximum": 16 },
            "maximumCount": { "type": "integer", "minimum": 1, "maximum": 16 },
            "profile": {
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "minimumWidth",
                    "maximumWidth",
                    "minimumHeight",
                    "maximumHeight",
                    "alpha",
                    "animation"
                  ],
                  "properties": {
                    "kind": { "const": "raster" },
                    "minimumWidth": {
                      "anyOf": [
                        { "type": "integer", "minimum": 1, "maximum": 16384 },
                        { "type": "null" }
                      ]
                    },
                    "maximumWidth": {
                      "anyOf": [
                        { "type": "integer", "minimum": 1, "maximum": 16384 },
                        { "type": "null" }
                      ]
                    },
                    "minimumHeight": {
                      "anyOf": [
                        { "type": "integer", "minimum": 1, "maximum": 16384 },
                        { "type": "null" }
                      ]
                    },
                    "maximumHeight": {
                      "anyOf": [
                        { "type": "integer", "minimum": 1, "maximum": 16384 },
                        { "type": "null" }
                      ]
                    },
                    "alpha": { "enum": ["allowed", "required", "forbidden"] },
                    "animation": { "enum": ["allowed", "required", "forbidden"] }
                  }
                }
              ]
            }
          }
        },
        "review": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "human-required" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ruleId"],
              "properties": {
                "kind": { "const": "deterministic-preauthorized" },
                "ruleId": { "$ref": "#/definitions/safeId" }
              }
            }
          ]
        },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workItemId", "direction", "criterionIds"],
            "properties": {
              "workItemId": { "$ref": "#/definitions/safeId" },
              "direction": { "enum": ["input-to", "evidence-for"] },
              "criterionIds": {
                "type": "array",
                "maxItems": 64,
                "uniqueItems": true,
                "items": { "$ref": "#/definitions/safeId" }
              }
            },
            "allOf": [
              {
                "if": { "properties": { "direction": { "const": "evidence-for" } } },
                "then": { "properties": { "criterionIds": { "minItems": 1 } } }
              }
            ]
          }
        },
        "repositoryCapture": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["expectedAssetId", "scenario", "captureRecipeId", "comparison"],
              "properties": {
                "expectedAssetId": { "$ref": "#/definitions/safeId" },
                "scenario": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "fixture", "seed"],
                  "properties": {
                    "id": { "$ref": "#/definitions/safeId" },
                    "fixture": {
                      "anyOf": [
                        { "type": "string", "minLength": 1, "maxLength": 500 },
                        { "type": "null" }
                      ]
                    },
                    "seed": {
                      "anyOf": [
                        { "type": "string", "minLength": 1, "maxLength": 500 },
                        { "type": "null" }
                      ]
                    }
                  },
                  "not": { "required": ["fixture", "seed"], "properties": { "fixture": { "type": "string" }, "seed": { "type": "string" } } }
                },
                "captureRecipeId": { "$ref": "#/definitions/safeId" },
                "comparison": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind"],
                      "properties": { "kind": { "const": "exact" } }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "recipeId"],
                      "properties": {
                        "kind": { "const": "threshold" },
                        "recipeId": { "$ref": "#/definitions/safeId" }
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "workItemDeliverable": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "contract"],
          "properties": {
            "kind": { "const": "repository-change" },
            "contract": { "const": "clockgrove.factory/artifact" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "contract",
            "intent",
            "producerCapabilityId",
            "producerCapabilityDigest",
            "activationSelection"
          ],
          "properties": {
            "kind": { "const": "asset-production" },
            "contract": { "const": "clockgrove.factory/asset-set" },
            "intent": { "$ref": "#/definitions/mediaIntent" },
            "producerCapabilityId": { "$ref": "#/definitions/safeId" },
            "producerCapabilityDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "activationSelection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minimumCount", "maximumCount"],
              "properties": {
                "minimumCount": { "type": "integer", "minimum": 1, "maximum": 16 },
                "maximumCount": { "type": "integer", "minimum": 1, "maximum": 16 }
              }
            }
          }
        }
      ]
    },
    "generatedAssetRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intentId",
        "producerWorkItemId",
        "role",
        "purpose",
        "necessity",
        "obligationIds",
        "brief",
        "rationale",
        "direction",
        "criterionIds",
        "inputRoleId"
      ],
      "properties": {
        "intentId": { "$ref": "#/definitions/safeId" },
        "producerWorkItemId": { "$ref": "#/definitions/safeId" },
        "role": { "$ref": "#/definitions/mediaIntentRole" },
        "purpose": { "$ref": "#/definitions/mediaIntentPurpose" },
        "necessity": { "enum": ["required", "helpful"] },
        "obligationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "brief": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "direction": { "const": "input-to" },
        "criterionIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/safeId" }
        },
        "inputRoleId": {
          "anyOf": [{ "$ref": "#/definitions/safeId" }, { "type": "null" }]
        }
      }
    },
    "workerMediaIntentUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "intentId",
        "role",
        "inputRoleId",
        "brief",
        "purpose",
        "necessity",
        "obligationIds",
        "rationale",
        "direction",
        "criterionIds",
        "descriptorDigests"
      ],
      "properties": {
        "source": { "enum": ["imported", "activated"] },
        "intentId": { "$ref": "#/definitions/safeId" },
        "role": { "$ref": "#/definitions/mediaIntentRole" },
        "inputRoleId": {
          "anyOf": [{ "$ref": "#/definitions/safeId" }, { "type": "null" }]
        },
        "brief": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "purpose": { "$ref": "#/definitions/mediaIntentPurpose" },
        "necessity": { "enum": ["required", "helpful"] },
        "obligationIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "direction": { "enum": ["input-to", "evidence-for"] },
        "criterionIds": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/safeId" }
        },
        "descriptorDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "producerWorkItemId": { "$ref": "#/definitions/safeId" },
        "activationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "oneOf": [
        {
          "properties": { "source": { "const": "imported" } },
          "required": ["manifestDigest"],
          "not": {
            "anyOf": [{ "required": ["producerWorkItemId"] }, { "required": ["activationDigest"] }]
          }
        },
        {
          "properties": { "source": { "const": "activated" } },
          "required": ["producerWorkItemId", "activationDigest"],
          "not": { "required": ["manifestDigest"] }
        }
      ]
    },
    "repositoryCaptureRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "mediaUse",
        "criterionIds",
        "criteria",
        "scenario",
        "captureCommand",
        "outputs",
        "profile",
        "comparison",
        "gate"
      ],
      "properties": {
        "id": { "$ref": "#/definitions/safeId" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mediaUse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intentId", "direction"],
          "properties": {
            "intentId": { "$ref": "#/definitions/safeId" },
            "direction": { "const": "evidence-for" }
          }
        },
        "criterionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/safeId" }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        },
        "scenario": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "fixture", "seed"],
          "properties": {
            "id": { "$ref": "#/definitions/safeId" },
            "fixture": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 500 },
                { "type": "null" }
              ]
            },
            "seed": {
              "anyOf": [
                { "type": "string", "minLength": 1, "maxLength": 500 },
                { "type": "null" }
              ]
            }
          },
          "not": { "required": ["fixture", "seed"], "properties": { "fixture": { "type": "string" }, "seed": { "type": "string" } } }
        },
        "captureCommand": { "$ref": "#/definitions/repositoryCommandIdentity" },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["roleId", "mediaType"],
            "properties": {
              "roleId": { "$ref": "#/definitions/safeId" },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+\\-]{0,126}/[a-zA-Z0-9][a-zA-Z0-9!#$&^_.+\\-]{0,126}$"
              }
            }
          }
        },
        "profile": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "viewport", "output", "captureRoleId", "diffRoleId", "previewRoleId", "constraints"],
              "properties": {
                "kind": { "const": "raster" },
                "viewport": { "$ref": "#/definitions/repositoryCaptureDimensions" },
                "output": { "$ref": "#/definitions/repositoryCaptureDimensions" },
                "captureRoleId": { "$ref": "#/definitions/safeId" },
                "diffRoleId": { "anyOf": [{ "$ref": "#/definitions/safeId" }, { "type": "null" }] },
                "previewRoleId": { "anyOf": [{ "$ref": "#/definitions/safeId" }, { "type": "null" }] },
                "constraints": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "minimumWidth", "maximumWidth", "minimumHeight", "maximumHeight", "alpha", "animation"],
                  "properties": {
                    "kind": { "const": "raster" },
                    "minimumWidth": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 16384 }, { "type": "null" }] },
                    "maximumWidth": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 16384 }, { "type": "null" }] },
                    "minimumHeight": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 16384 }, { "type": "null" }] },
                    "maximumHeight": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 16384 }, { "type": "null" }] },
                    "alpha": { "enum": ["allowed", "required", "forbidden"] },
                    "animation": { "enum": ["allowed", "required", "forbidden"] }
                  }
                }
              }
            }
          ]
        },
        "comparison": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "outputRoleId", "expectedDescriptorDigest", "policy"],
              "properties": {
                "kind": { "const": "exact" },
                "outputRoleId": { "$ref": "#/definitions/safeId" },
                "expectedDescriptorDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind"],
                  "properties": { "kind": { "const": "exact-bytes" } }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "outputRoleId", "comparator", "expectedDescriptorDigest", "policy"],
              "properties": {
                "kind": { "const": "threshold" },
                "outputRoleId": { "$ref": "#/definitions/safeId" },
                "comparator": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "contract"],
                  "properties": {
                    "id": { "$ref": "#/definitions/safeId" },
                    "contract": { "type": "integer", "minimum": 1, "maximum": 1000 }
                  }
                },
                "expectedDescriptorDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "metric", "maximumDifference"],
                  "properties": {
                    "kind": { "const": "bounded-difference" },
                    "metric": { "$ref": "#/definitions/safeId" },
                    "maximumDifference": { "type": "number", "minimum": 0 }
                  }
                }
              }
            }
          ]
        },
        "gate": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": { "kind": { "const": "human-required" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "ruleId"],
              "properties": {
                "kind": { "const": "deterministic-preauthorized" },
                "ruleId": { "$ref": "#/definitions/safeId" }
              }
            }
          ]
        }
      }
    },
    "repositoryCommandIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recipeId", "recipeDigest", "command"],
      "properties": {
        "recipeId": { "$ref": "#/definitions/safeId" },
        "recipeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "command": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "repositoryCaptureDimensions": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
          }
        }
      ]
    },
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/+\\-]+$"
    },
    "repositoryCapabilityOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._:/+\\-]+$"
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._:/+\\-]+$"
        }
      }
    },
    "runtimeBundleRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "adapter", "adapterContract", "platform", "releaseChannel"],
      "properties": {
        "tool": { "enum": ["npm", "pnpm", "bun", "uv"] },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._:/+\\-]+$"
        },
        "adapterContract": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "architecture", "libc"],
          "properties": {
            "os": { "const": "linux" },
            "architecture": { "const": "x64" },
            "libc": { "const": "glibc" }
          }
        },
        "releaseChannel": { "const": "ga" },
        "bundleDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "deliverable": { "$ref": "#/definitions/workItemDeliverable/oneOf/0" },
        "allowedPaths": { "minItems": 1 },
        "validationCommands": { "minItems": 1 }
      }
    },
    {
      "properties": {
        "deliverable": { "$ref": "#/definitions/workItemDeliverable/oneOf/1" },
        "allowedPaths": { "maxItems": 0 },
        "validationCommands": { "maxItems": 0 }
      },
      "not": {
        "anyOf": [
          { "required": ["context"] },
          { "required": ["changeSurface"] },
          { "required": ["delivery"] },
          { "required": ["criterionRisks"] },
          { "required": ["validation"] },
          { "required": ["repositoryCapabilities"] },
          { "required": ["managedRuntimes"] },
          { "required": ["repositoryCaptureRecipes"] }
        ]
      }
    }
  ]
}
