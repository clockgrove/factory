{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/clockgrove/factory/schemas/worker-packet.schema.json",
  "title": "Factory v2 Worker Packet",
  "type": "object",
  "additionalProperties": true,
  "required": ["goal", "acceptanceCriteria", "allowedPaths", "preconditions", "outOfScope", "conventions", "baseSha", "validationCommands", "requirements", "artifactContract"],
  "properties": {
    "goal": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "allowedPaths": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*[*?\\[]).+$" } },
    "preconditions": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "outOfScope": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "conventions": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "retryContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt", "outcome", "reason"],
      "properties": {
        "attempt": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["failed", "timed_out"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "baseSha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "validationCommands": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "requirements": {
      "type": "object",
      "additionalProperties": true,
      "required": ["os", "architecture", "tools", "services", "networkDestinations", "permittedSecretNames", "trust"],
      "properties": {
        "os": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "architecture": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 40 } },
        "cpu": { "type": "number", "exclusiveMinimum": 0, "maximum": 256 },
        "memoryMb": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "diskMb": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "timeoutMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "tools": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" } },
        "services": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)?$" } },
        "networkDestinations": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 253 } },
        "permittedSecretNames": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,127}$" } },
        "trust": { "enum": ["trusted_local", "isolated", "managed"] }
      }
    },
    "artifactContract": { "const": "clockgrove.factory/artifact-v1" }
  }
}
